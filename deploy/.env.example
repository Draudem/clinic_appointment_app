# Шаблон секретов для деплоя. Скопируй в .env и подставь свои значения:
#   cp deploy/.env.example deploy/.env
# Файл .env в git не попадает (см. .gitignore).

# Пароль postgres-пользователя clinic
DB_PASSWORD=change-me

# Секрет подписи JWT, минимум 32 символа (сгенерировать: openssl rand -hex 24)
JWT_SECRET=change-me-please-use-at-least-32-characters

# --- Голосовой контур (необязательно; значения по умолчанию уже рабочие) ---
# Парсер команд: nlu (локальная ONNX-модель) | rule | rag-llm
VOICE_PARSER=nlu
# Ollama на этом сервере НЕ разворачиваем (мало RAM). Если появится внешний LLM —
# включить LLM_ENABLED=true и указать LLM_BASE_URL / LLM_MODEL.
LLM_ENABLED=false

# --- Телефония: AudioSocket + GigaAM (распознавание) + Piper (синтез) ---
# Файлы моделей и нативной библиотеки НЕ лежат в репозитории (~280 МБ).
# Их качает deploy-local.sh автоматически; вручную:
#   ./deploy/fetch-stt-model.sh   # GigaAM, 227 МБ
#   ./deploy/fetch-stt-libs.sh   # libonnxruntime 1.17.1 для sherpa-onnx, 15 МБ
#   ./deploy/fetch-tts-model.sh   # Piper ru_RU-irina (женский голос), 37 МБ

# Голосовой ответ в трубку. Выключенный TTS НЕ ломает звонки: они принимаются,
# речь распознаётся, просто звонящий слышит тишину (сработает заглушка).
TTS_ENABLED=true
# Темп речи: 1.0 — обычный, меньше — медленнее.
TTS_SPEED=1.0
# Фразы сценария. Кавычки обязательны — в тексте есть двоеточие.
TTS_GREETING="Для записи на приём сообщите следующую информацию: специальность или симптомы, желаемую дату и время."
TTS_REPLY_ON_SILENCE="Спасибо, записываю."

# Открытый доступ к распознанным фразам без JWT — только для наладки телефонии.
# Наружу выкладывать НЕЛЬЗЯ: это транскрипты разговоров с пациентами.
STT_PUBLIC_READ=true

# Память контейнера бэкенда. Модели распознавания и синтеза живут вне кучи JVM
# (нативный код), поэтому лимит заметно больше -Xmx.
# Замерено с обеими моделями: ~1134 МБ resident.
BACKEND_MEM_LIMIT=1600m
BACKEND_XMX=384m
